+# EasyAuth (Azure Container Apps built-in authentication) injects the logged-in
+# user's email/UPN as X-MS-CLIENT-PRINCIPAL-NAME before requests reach Chainlit.
+# This callback turns those injected headers into a cl.User so the user icon
+# and identity are visible in the UI, and get_auth_info() picks up the email.
+@cl.header_auth_callback
+async def easyauth_header_callback(headers: Dict) -> Optional[cl.User]:
+    principal_name = (headers.get("x-ms-client-principal-name") or "").strip()
+    if not principal_name:
+        logger.debug("EasyAuth: no x-ms-client-principal-name header present.")
+        return None
+    principal_id = (headers.get("x-ms-client-principal-id") or principal_name).strip()
+    logger.info("EasyAuth: authenticated user principal=%s", principal_name)
+    return cl.User(
+        identifier=principal_name,
+        metadata={
+            "client_principal_name": principal_name,
+            "client_principal_id": principal_id,
+            "authorized": True,
+            "access_token": None,
+        },
+    )
+
